{
  "name": "geo-coverage",
  "version": "2.0.0",
  "private": true,
  "description": "Redivis Labs geo coverage visualization",
  "scripts": {
    "start": "webpack serve --env development",
    "build": "webpack",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx}\" *.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Redivis/geo-coverage.git"
  },
  "author": "Redivis Inc.",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/Redivis/geo-coverage/issues"
  },
  "homepage": "https://github.com/Redivis/geo-coverage#readme",
  "engines": {
    "node": ">=22.15"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@turf/bbox": "7.4.0",
    "colorbrewer": "1.7.0",
    "d3": "7.9.0",
    "fuzzyset.js": "1.0.7",
    "heap": "0.2.7",
    "localforage": "1.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redivis": "0.4.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@eslint/js": "10.0.1",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "8.5.32",
    "postcss-loader": "8.2.1",
    "postcss-preset-env": "11.6.1",
    "postcss-pxtorem": "6.1.0",
    "prettier": "3.9.10",
    "style-loader": "4.0.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.1.0"
  },
  "prettier": {
    "printWidth": 120,
    "useTabs": true,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always"
  }
}
